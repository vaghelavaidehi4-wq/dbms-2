-- =====================================================
  .2: Indian Income Tax Calculator 2024-25
-- Roll No: 1 (Seed = 5 style example used)
-- =====================================================
DECLARE
    v_gross_salary   NUMBER := 250000;   -- example: 2.5L
    v_std_deduction  NUMBER := 75000;
    v_taxable        NUMBER;
    v_tax            NUMBER := 0;
    v_tds_monthly    NUMBER;
    v_takehome       NUMBER;
BEGIN
    v_taxable := v_gross_salary - v_std_deduction;
    IF v_taxable < 0 THEN
        v_taxable := 0;
    END IF;

    -- SEARCHED CASE for tax slabs
    CASE
        WHEN v_taxable <= 300000 THEN
            v_tax := 0;
        WHEN v_taxable > 300000 AND v_taxable <= 700000 THEN
            v_tax := (v_taxable - 300000) * 0.05;
        WHEN v_taxable > 700000 AND v_taxable <= 1000000 THEN
            v_tax := (400000 * 0.05) + (v_taxable - 700000) * 0.10;
        WHEN v_taxable > 1000000 AND v_taxable <= 1200000 THEN
            v_tax := (400000 * 0.05) + (300000 * 0.10) + (v_taxable - 1000000) * 0.15;
        WHEN v_taxable > 1200000 AND v_taxable <= 1500000 THEN
            v_tax := (400000 * 0.05) + (300000 * 0.10) + (200000 * 0.15) + (v_taxable - 1200000) * 0.20;
        WHEN v_taxable > 1500000 THEN
            v_tax := (400000 * 0.05) + (300000 * 0.10) + (200000 * 0.15) + (300000 * 0.20) + (v_taxable - 1500000) * 0.30;
        ELSE
            v_tax := 0;
    END CASE;

    v_tds_monthly := v_tax / 12;
    v_takehome    := (v_gross_salary - v_tax) / 12;

    DBMS_OUTPUT.PUT_LINE('===== INCOME TAX BREAKDOWN 2024-25 =====');
    DBMS_OUTPUT.PUT_LINE('Gross Salary: Rs.' || v_gross_salary);
    DBMS_OUTPUT.PUT_LINE('Standard Deduction: Rs.' || v_std_deduction);
    DBMS_OUTPUT.PUT_LINE('Taxable Income: Rs.' || v_taxable);
    DBMS_OUTPUT.PUT_LINE('Total Tax: Rs.' || v_tax);
    DBMS_OUTPUT.PUT_LINE('Monthly TDS: Rs.' || ROUND(v_tds_monthly,2));
    DBMS_OUTPUT.PUT_LINE('Take-Home Monthly Salary: Rs.' || ROUND(v_takehome,2));

    IF v_tax = 0 THEN
        DBMS_OUTPUT.PUT_LINE('No tax this year — save more with PPF/ELSS!');
    END IF;
END;

-- =====================================================
3: ATM Machine Simulation
-- Roll No: 1  => initial_balance = 1*500+5000 = 5500
-- =====================================================
DECLARE
    v_balance       NUMBER := 5500;
    v_choice        NUMBER := 1;   -- 1=Withdraw, 2=Balance, 3=Exit
    v_amount        NUMBER;
    v_txn_count     NUMBER := 0;
    v_total_withdrawn NUMBER := 0;
    v_iteration     NUMBER := 0;
    TYPE t_amt_arr IS VARRAY(4) OF NUMBER;
    v_withdraw_seq  t_amt_arr := t_amt_arr(500, 1000, 500, 0); -- 0 = simulate exit
BEGIN
    DBMS_OUTPUT.PUT_LINE('===== ATM SIMULATION START =====');
    DBMS_OUTPUT.PUT_LINE('Initial Balance: Rs.' || v_balance);

    LOOP
        v_iteration := v_iteration + 1;
        EXIT WHEN v_iteration > v_withdraw_seq.COUNT;

        v_amount := v_withdraw_seq(v_iteration);

        IF v_amount = 0 THEN
            v_choice := 3;  -- simulate Exit selection
        ELSE
            v_choice := 1;  -- Withdrawal
        END IF;

        EXIT WHEN v_choice = 3 OR v_balance = 0;

        IF v_choice = 1 THEN
            IF v_amount <= 0 THEN
                DBMS_OUTPUT.PUT_LINE('Error: Amount must be greater than 0');
            ELSIF MOD(v_amount, 100) != 0 THEN
                DBMS_OUTPUT.PUT_LINE('Error: Amount must be a multiple of 100');
            ELSIF v_amount > 10000 THEN
                DBMS_OUTPUT.PUT_LINE('Error: Cannot withdraw more than Rs.10000 per transaction');
            ELSIF v_amount > v_balance THEN
                DBMS_OUTPUT.PUT_LINE('Error: Insufficient balance');
            ELSE
                v_balance := v_balance - v_amount;
                v_total_withdrawn := v_total_withdrawn + v_amount;
                v_txn_count := v_txn_count + 1;
                DBMS_OUTPUT.PUT_LINE('--- Transaction ' || v_txn_count || ' ---');
                DBMS_OUTPUT.PUT_LINE('Withdrawn: Rs.' || v_amount);
                DBMS_OUTPUT.PUT_LINE('Remaining Balance: Rs.' || v_balance);
            END IF;
        END IF;
    END LOOP;

    DBMS_OUTPUT.PUT_LINE('===== FINAL SUMMARY =====');
    DBMS_OUTPUT.PUT_LINE('Total Transactions: ' || v_txn_count);
    DBMS_OUTPUT.PUT_LINE('Total Withdrawn: Rs.' || v_total_withdrawn);
    DBMS_OUTPUT.PUT_LINE('Closing Balance: Rs.' || v_balance);
END;
/


-- =====================================================
4: Loops and Patterns
-- Roll No: 1 => table = (1 MOD 9)+2 = 3, height = 5+(1 MOD 5) = 6
-- =====================================================
DECLARE
    v_table  NUMBER := MOD(1,9) + 2;   -- = 3
    v_height NUMBER := 5 + MOD(1,5);   -- = 6
BEGIN
    -- Part A: Multiplication table
    DBMS_OUTPUT.PUT_LINE('===== PART A: Table of ' || v_table || ' =====');
    FOR i IN 1..20 LOOP
        DBMS_OUTPUT.PUT_LINE(v_table || ' x ' || i || ' = ' || (v_table * i));
    END LOOP;

    -- Part B: Tables of 2,3,4,5 with LPAD alignment
    DBMS_OUTPUT.PUT_LINE('===== PART B: Tables 2-5 =====');
    FOR t IN 2..5 LOOP
        FOR i IN 1..10 LOOP
            DBMS_OUTPUT.PUT_LINE(LPAD(t,2) || ' x ' || LPAD(i,2) || ' = ' || LPAD(t*i,3));
        END LOOP;
        DBMS_OUTPUT.PUT_LINE('------------');
    END LOOP;

    -- Part C: Right-angled star triangle
    DBMS_OUTPUT.PUT_LINE('===== PART C: Star Triangle (height=' || v_height || ') =====');
    FOR i IN 1..v_height LOOP
        DBMS_OUTPUT.PUT_LINE(RPAD('*', i, '*'));
    END LOOP;

    -- Part D: Number pyramid
    DBMS_OUTPUT.PUT_LINE('===== PART D: Number Pyramid =====');
    FOR i IN 1..6 LOOP
        DECLARE
            v_line VARCHAR2(50) := '';
        BEGIN
            FOR j IN 1..i LOOP
                v_line := v_line || j;
            END LOOP;
            DBMS_OUTPUT.PUT_LINE(v_line);
        END;
    END LOOP;

    -- Part E: Reverse star triangle
    DBMS_OUTPUT.PUT_LINE('===== PART E: Reverse Star Triangle =====');
    FOR i IN REVERSE 1..v_height LOOP
        DBMS_OUTPUT.PUT_LINE(RPAD('*', i, '*'));
    END LOOP;
END;
/


-- =====================================================
5: Fibonacci, Primes and GCD
-- Roll No: 1 => N = 5 + (1 MOD 8) = 6
-- =====================================================
DECLARE
    v_n       NUMBER := 5 + MOD(1,8);  -- = 6
    v_a       NUMBER := 0;
    v_b       NUMBER := 1;
    v_next    NUMBER;
    v_count   NUMBER := 0;
    v_last_fib NUMBER;
    v_is_prime BOOLEAN := TRUE;
    v_i        NUMBER;
    v_prime_count NUMBER := 0;
    v_x NUMBER; v_y NUMBER; v_r NUMBER;
    v_sum_div NUMBER;
    v_perfect_num NUMBER := 28;
BEGIN
    -- Part A: Fibonacci
    DBMS_OUTPUT.PUT_LINE('===== PART A: First ' || v_n || ' Fibonacci Numbers =====');
    v_a := 0; v_b := 1;
    WHILE v_count < v_n LOOP
        DBMS_OUTPUT.PUT_LINE(v_a);
        v_last_fib := v_a;
        v_next := v_a + v_b;
        v_a := v_b;
        v_b := v_next;
        v_count := v_count + 1;
    END LOOP;

    -- Part B: Is Nth Fibonacci prime?
    v_is_prime := (v_last_fib > 1);
    v_i := 2;
    WHILE v_i * v_i <= v_last_fib AND v_is_prime LOOP
        IF MOD(v_last_fib, v_i) = 0 THEN
            v_is_prime := FALSE;
        END IF;
        v_i := v_i + 1;
    END LOOP;
    DBMS_OUTPUT.PUT_LINE('Nth Fibonacci = ' || v_last_fib || ' is ' ||
        CASE WHEN v_is_prime THEN 'PRIME' ELSE 'NOT PRIME' END);

    -- Part C: Primes 1-100
    DBMS_OUTPUT.PUT_LINE('===== PART C: Primes 1-100 =====');
    FOR n IN 2..100 LOOP
        v_is_prime := TRUE;
        v_i := 2;
        WHILE v_i * v_i <= n LOOP
            IF MOD(n, v_i) = 0 THEN
                v_is_prime := FALSE;
                EXIT;
            END IF;
            v_i := v_i + 1;
        END LOOP;
        IF v_is_prime THEN
            DBMS_OUTPUT.PUT_LINE(n);
            v_prime_count := v_prime_count + 1;
        END IF;
    END LOOP;
    DBMS_OUTPUT.PUT_LINE('Total Primes Found: ' || v_prime_count);

    -- Part D: GCD (Euclidean)
    v_x := 48; v_y := 18;
    DBMS_OUTPUT.PUT_LINE('===== PART D: GCD of ' || v_x || ' and ' || v_y || ' =====');
    WHILE v_y != 0 LOOP
        v_r := MOD(v_x, v_y);
        v_x := v_y;
        v_y := v_r;
    END LOOP;
    DBMS_OUTPUT.PUT_LINE('GCD = ' || v_x);

    -- Part E: Perfect number check
    v_sum_div := 0;
    FOR d IN 1..(v_perfect_num - 1) LOOP
        IF MOD(v_perfect_num, d) = 0 THEN
            v_sum_div := v_sum_div + d;
        END IF;
    END LOOP;
    DBMS_OUTPUT.PUT_LINE('===== PART E: Perfect Number Check (' || v_perfect_num || ') =====');
    IF v_sum_div = v_perfect_num THEN
        DBMS_OUTPUT.PUT_LINE(v_perfect_num || ' IS a Perfect Number');
    ELSE
        DBMS_OUTPUT.PUT_LINE(v_perfect_num || ' is NOT a Perfect Number');
    END IF;
END;
/

-- =====================================================
6: Zomato Delivery Price Engine
-- =====================================================
DECLARE
    v_food_total   NUMBER := 350;
    v_distance     NUMBER := 5;
    v_is_rain      CHAR(1) := 'Y';
    v_is_late_night CHAR(1) := 'N';
    v_is_festival   CHAR(1) := 'N';
    v_is_peak       CHAR(1) := 'N';
    v_order_value_over_499 BOOLEAN;
    v_first_order   BOOLEAN := FALSE;

    v_base_charge  NUMBER := 0;
    v_delivery     NUMBER := 0;
    v_surcharge_pct NUMBER := 0;
    v_grand_total  NUMBER;
BEGIN
    -- Base charge by distance
    IF v_distance < 3 THEN
        v_base_charge := 0;
    ELSIF v_distance <= 8 THEN
        v_base_charge := 29;
    ELSIF v_distance <= 15 THEN
        v_base_charge := 49;
    ELSE
        v_base_charge := 79;
    END IF;

    v_delivery := v_base_charge;

    -- Surcharges using CASE
    CASE
        WHEN v_is_rain = 'Y' THEN
            v_surcharge_pct := v_surcharge_pct + 20;
        ELSE NULL;
    END CASE;

    CASE
        WHEN v_is_late_night = 'Y' THEN
            v_surcharge_pct := v_surcharge_pct + 15;
        ELSE NULL;
    END CASE;

    CASE
        WHEN v_is_festival = 'Y' THEN
            v_surcharge_pct := v_surcharge_pct + 10;
        ELSE NULL;
    END CASE;

    CASE
        WHEN v_is_peak = 'Y' THEN
            v_surcharge_pct := v_surcharge_pct + 10;
        ELSE NULL;
    END CASE;

    v_delivery := ROUND(v_base_charge * (1 + v_surcharge_pct/100));

    -- Discounts using IF (override logic)
    v_order_value_over_499 := (v_food_total > 499);

    IF v_order_value_over_499 THEN
        v_delivery := 0;
    ELSIF v_first_order THEN
        v_delivery := ROUND(v_delivery * 0.5);
    END IF;

    v_grand_total := v_food_total + v_delivery;

    DBMS_OUTPUT.PUT_LINE('===== ZOMATO DELIVERY RECEIPT =====');
    DBMS_OUTPUT.PUT_LINE('Food Total: Rs.' || v_food_total);
    DBMS_OUTPUT.PUT_LINE('Distance: ' || v_distance || ' km');
    DBMS_OUTPUT.PUT_LINE('Base Delivery Charge: Rs.' || v_base_charge);
    DBMS_OUTPUT.PUT_LINE('Surcharge Applied: ' || v_surcharge_pct || '%');
    DBMS_OUTPUT.PUT_LINE('Final Delivery Charge: Rs.' || v_delivery);
    DBMS_OUTPUT.PUT_LINE('Grand Total: Rs.' || v_grand_total);
END;
/


-- ==================================================
7: Student Result + Attendance System
-- =====================================================
DECLARE
    v_attendance_pct  NUMBER := 51;
    v_theory_marks    NUMBER := 31;   -- out of 70
    v_practical_marks NUMBER := 13;   -- out of 30
    v_assignment_marks NUMBER := 15;  -- out of 20 (max 10 counted)

    v_assign_counted  NUMBER;
    v_total           NUMBER;
    v_pct             NUMBER;
    v_grade           VARCHAR2(5);
    v_result          VARCHAR2(20);
    v_remark          VARCHAR2(100);
BEGIN
    v_assign_counted := LEAST(v_assignment_marks, 10);

    IF v_attendance_pct < 40 THEN
        v_result := 'DETAINED';
        v_remark := 'Insufficient attendance. Not eligible to appear.';
    ELSIF v_theory_marks < 28 THEN
        v_result := 'FAIL';
        v_remark := 'Failed in Theory (min 28 required)';
    ELSIF v_practical_marks < 12 THEN
        v_result := 'FAIL';
        v_remark := 'Failed in Practical (min 12 required)';
    ELSE
        v_total := v_theory_marks + v_practical_marks + v_assign_counted;
        v_pct   := (v_total / 120) * 100;

        CASE
            WHEN v_pct >= 90 THEN v_grade := 'A+';
            WHEN v_pct >= 80 THEN v_grade := 'A';
            WHEN v_pct >= 70 THEN v_grade := 'B';
            WHEN v_pct >= 60 THEN v_grade := 'C';
            WHEN v_pct >= 50 THEN v_grade := 'D';
            ELSE v_grade := 'FAIL';
        END CASE;

        IF v_pct >= 90 THEN
            v_result := 'PASS';
            v_remark := 'DISTINCTION - Excellent Performance';
        ELSIF v_pct >= 60 THEN
            v_result := 'PASS';
            v_remark := 'FIRST CLASS - Well Done';
        ELSIF v_pct >= 50 THEN
            v_result := 'PASS';
            v_remark := 'SECOND CLASS - Good Effort';
        ELSE
            v_result := 'PASS';
            v_remark := 'PASS CLASS - Needs Improvement';
        END IF;
    END IF;

    DBMS_OUTPUT.PUT_LINE('===== SEMESTER RESULT / MARKSHEET =====');
    DBMS_OUTPUT.PUT_LINE('Attendance: ' || v_attendance_pct || '%');
    DBMS_OUTPUT.PUT_LINE('Theory Marks: ' || v_theory_marks || '/70');
    DBMS_OUTPUT.PUT_LINE('Practical Marks: ' || v_practical_marks || '/30');
    DBMS_OUTPUT.PUT_LINE('Assignment Marks Counted: ' || v_assign_counted || '/10');

    IF v_total IS NOT NULL THEN
        DBMS_OUTPUT.PUT_LINE('Total: ' || v_total || '/120');
        DBMS_OUTPUT.PUT_LINE('Percentage: ' || ROUND(v_pct,2) || '%');
        DBMS_OUTPUT.PUT_LINE('Grade: ' || v_grade);
    END IF;

    DBMS_OUTPUT.PUT_LINE('Result: ' || v_result);
    DBMS_OUTPUT.PUT_LINE('Remark: ' || v_remark);
END;
/


-- =====================================================
8: Loan EMI Affordability Checker
-- =====================================================
DECLARE
    v_monthly_salary  NUMBER := 25000;
    v_existing_emi    NUMBER := 0;
    v_loan_amount     NUMBER := 250000;
    v_annual_rate     NUMBER := 10.5;
    v_tenure_months   NUMBER := 120;

    v_r        NUMBER;
    v_emi      NUMBER;
    v_foir_limit NUMBER;
    v_max_loan NUMBER;
    v_approved_amount NUMBER;
    v_decision VARCHAR2(20);
    v_total_emi_with_new NUMBER;
BEGIN
    v_r := (v_annual_rate / 12) / 100;
    v_max_loan := v_monthly_salary * 60;
    v_foir_limit := v_monthly_salary * 0.40;

    -- EMI formula
    v_emi := ROUND(
                v_loan_amount * v_r * POWER(1+v_r, v_tenure_months)
                / (POWER(1+v_r, v_tenure_months) - 1)
             );

    v_total_emi_with_new := v_existing_emi + v_emi;
    v_approved_amount := v_loan_amount;

    IF v_monthly_salary < 25000 THEN
        v_decision := 'REJECTED';
        v_approved_amount := 0;
    ELSIF v_loan_amount > v_max_loan THEN
        v_decision := 'CONDITIONAL';
        v_approved_amount := v_max_loan;
    ELSIF v_total_emi_with_new > v_foir_limit THEN
        -- WHILE LOOP: reduce loan by 10000 until EMI fits FOIR
        v_approved_amount := v_loan_amount;
        WHILE v_total_emi_with_new > v_foir_limit AND v_approved_amount > 0 LOOP
            v_approved_amount := v_approved_amount - 10000;
            v_emi := ROUND(
                        v_approved_amount * v_r * POWER(1+v_r, v_tenure_months)
                        / (POWER(1+v_r, v_tenure_months) - 1)
                     );
            v_total_emi_with_new := v_existing_emi + v_emi;
        END LOOP;
        v_decision := 'CONDITIONAL';
    ELSE
        v_decision := 'APPROVED';
    END IF;

    CASE v_decision
        WHEN 'APPROVED' THEN
            DBMS_OUTPUT.PUT_LINE('Status: APPROVED - Full loan amount sanctioned');
        WHEN 'CONDITIONAL' THEN
            DBMS_OUTPUT.PUT_LINE('Status: CONDITIONAL - Reduced loan amount approved');
        WHEN 'REJECTED' THEN
            DBMS_OUTPUT.PUT_LINE('Status: REJECTED - Salary below minimum eligibility');
    END CASE;

    DBMS_OUTPUT.PUT_LINE('===== LOAN EMI REPORT =====');
    DBMS_OUTPUT.PUT_LINE('Monthly Salary: Rs.' || v_monthly_salary);
    DBMS_OUTPUT.PUT_LINE('Requested Loan: Rs.' || v_loan_amount);
    DBMS_OUTPUT.PUT_LINE('Calculated EMI: Rs.' || v_emi);
    DBMS_OUTPUT.PUT_LINE('FOIR Limit (40%): Rs.' || v_foir_limit);
    DBMS_OUTPUT.PUT_LINE('Max Eligible Loan (60x salary): Rs.' || v_max_loan);
    DBMS_OUTPUT.PUT_LINE('Approved Amount: Rs.' || v_approved_amount);
    DBMS_OUTPUT.PUT_LINE('Decision: ' || v_decision);
END;
/
