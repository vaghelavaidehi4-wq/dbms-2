-- =====================================================
1: Complete Grade Card System
-- Roll No: 1
-- =====================================================
DECLARE
    v_sub1 NUMBER := 43;
    v_sub2 NUMBER := 53;
    v_sub3 NUMBER := 63;
    v_sub4 NUMBER := 73;
    v_sub5 NUMBER := 83;
    v_total NUMBER;
    v_pct   NUMBER;
    v_grade VARCHAR2(5);
    v_detained BOOLEAN := FALSE;
    v_fail_list VARCHAR2(200) := '';
BEGIN
    v_total := v_sub1 + v_sub2 + v_sub3 + v_sub4 + v_sub5;
    v_pct   := v_total / 5;

    -- Grade using IF-ELSIF
    IF v_pct >= 90 THEN
        v_grade := 'A+';
    ELSIF v_pct >= 80 THEN
        v_grade := 'A';
    ELSIF v_pct >= 70 THEN
        v_grade := 'B';
    ELSIF v_pct >= 60 THEN
        v_grade := 'C';
    ELSIF v_pct >= 50 THEN
        v_grade := 'D';
    ELSE
        v_grade := 'FAIL';
    END IF;

    -- Nested IF: check DETAINED condition (any subject < 35)
    IF v_sub1 < 35 THEN
        v_detained := TRUE; v_fail_list := v_fail_list || 'Subject1 ';
    END IF;
    IF v_sub2 < 35 THEN
        v_detained := TRUE; v_fail_list := v_fail_list || 'Subject2 ';
    END IF;
    IF v_sub3 < 35 THEN
        v_detained := TRUE; v_fail_list := v_fail_list || 'Subject3 ';
    END IF;
    IF v_sub4 < 35 THEN
        v_detained := TRUE; v_fail_list := v_fail_list || 'Subject4 ';
    END IF;
    IF v_sub5 < 35 THEN
        v_detained := TRUE; v_fail_list := v_fail_list || 'Subject5 ';
    END IF;

    DBMS_OUTPUT.PUT_LINE('===== GRADE CARD REPORT =====');
    DBMS_OUTPUT.PUT_LINE('Subject 1: ' || v_sub1);
    DBMS_OUTPUT.PUT_LINE('Subject 2: ' || v_sub2);
    DBMS_OUTPUT.PUT_LINE('Subject 3: ' || v_sub3);
    DBMS_OUTPUT.PUT_LINE('Subject 4: ' || v_sub4);
    DBMS_OUTPUT.PUT_LINE('Subject 5: ' || v_sub5);
    DBMS_OUTPUT.PUT_LINE('Total: ' || v_total);
    DBMS_OUTPUT.PUT_LINE('Percentage: ' || v_pct || '%');
    DBMS_OUTPUT.PUT_LINE('Grade: ' || v_grade);

    IF v_detained THEN
        DBMS_OUTPUT.PUT_LINE('Result: DETAINED');
        DBMS_OUTPUT.PUT_LINE('Failed in: ' || v_fail_list);
    ELSE
        DBMS_OUTPUT.PUT_LINE('Result: PASS');
        IF v_pct >= 75 THEN
            DBMS_OUTPUT.PUT_LINE('Class: Distinction');
        ELSIF v_pct >= 60 THEN
            DBMS_OUTPUT.PUT_LINE('Class: First Class');
        ELSIF v_pct >= 50 THEN
            DBMS_OUTPUT.PUT_LINE('Class: Second Class');
        ELSE
            DBMS_OUTPUT.PUT_LINE('Class: Pass Class');
        END IF;
    END IF;
END;
